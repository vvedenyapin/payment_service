# Postgres
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# API
API_KEY=super-secret-api-key

# Outbox relay
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=20

# Payment gateway emulation
GATEWAY_MIN_DELAY_SECONDS=2
GATEWAY_MAX_DELAY_SECONDS=5
GATEWAY_SUCCESS_RATE=0.9

# Webhook delivery
WEBHOOK_MAX_RETRIES=3
WEBHOOK_BASE_BACKOFF_SECONDS=1
WEBHOOK_TIMEOUT_SECONDS=5

# Message processing retry (before DLQ)
MESSAGE_MAX_RETRIES=3
